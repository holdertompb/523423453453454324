local function HatchAllReadyEggs()
    if not EggState then return 0 end
    local snapshot = nil
    if EggState.ReadOwnedEggs then
        local ok, snap = pcall(EggState.ReadOwnedEggs, LP.UserId)
        if not ok or not snap then
            ok, snap = pcall(EggState.ReadOwnedEggs)
        end
        if ok then snapshot = snap end
    end
    if not snapshot then return 0 end

    local records = snapshot.Records or snapshot.Eggs or snapshot.Owned or snapshot
    if typeof(records) ~= "table" then return 0 end

    local function extractUid(key, egg)
        if type(key) == "string" and key ~= "" then return key end
        if typeof(egg) == "table" then
            local u = egg.Uid or egg.UID or egg.uid or egg.Id or egg.id or egg.GUID or egg.Guid or egg.EggUid
            if type(u) == "string" and u ~= "" then return u end
            if type(u) == "number" then return tostring(u) end
        end
        if type(key) == "number" then return nil end
        local s = tostring(key)
        if s ~= "" and s ~= "nil" then return s end
        return nil
    end

    local function isReady(egg, uid)
        if EggState.IsReadyToHatch then
            -- prefer string uid (t library validates string)
            if uid then
                local ok, r = pcall(EggState.IsReadyToHatch, uid)
                if ok and r then return true end
            end
            local ok, r = pcall(EggState.IsReadyToHatch, egg)
            if ok and r then return true end
        end
        if egg.Ready == true or egg.IsReady == true or egg.CanHatch == true then return true end
        if type(egg.HatchAt) == "number" and egg.HatchAt > 0 and egg.HatchAt <= os.time() then return true end
        if type(egg.ReadyAt) == "number" and egg.ReadyAt <= os.time() then return true end
        if egg.Placement ~= nil then
            if egg.Progress == nil then return true end
            if type(egg.Progress) == "number" and egg.Progress >= 1 then return true end
        end
        return false
    end

    local function doHatch(uid, egg)
        local hatched = false
        if EggState.BeginHatch then
            local ok = pcall(EggState.BeginHatch, uid)
            if not ok then pcall(EggState.BeginHatch, egg) end
            hatched = true
        end
        task.wait(0.08)
        if EggState.FinishHatch then
            local ok = pcall(EggState.FinishHatch, uid)
            if not ok then pcall(EggState.FinishHatch, egg) end
            hatched = true
        end
        if EggState.Hatch then
            local ok = pcall(EggState.Hatch, uid)
            if not ok then pcall(EggState.Hatch, egg) end
            hatched = true
        end
        -- remote fallbacks
        local names = {
            "RF/Egg/AskHatch", "RF/Eggs/AskHatch", "RF/Hatch/Ask",
            "RE/Egg/AskHatch", "RE/Eggs/Hatch", "RE/Hatch/Begin",
            "RF/EggWorld/AskHatch", "RE/EggWorld/AskHatch",
        }
        for _, n in ipairs(names) do
            local re = GetNetRemote(n)
            if re then
                if re:IsA("RemoteFunction") then
                    pcall(function() re:InvokeServer(uid) end)
                else
                    pcall(function() re:FireServer(uid) end)
                end
                hatched = true
                break
            end
        end
        return hatched
    end

    local count = 0
    for key, eggData in pairs(records) do
        if typeof(eggData) == "table" then
            local uid = extractUid(key, eggData)
            if uid and isReady(eggData, uid) then
                local ok = pcall(doHatch, uid, eggData)
                if ok then count = count + 1 end
                task.wait(0.05)
            end
        end
    end
    return count
end

