local instantPickupConn = nil
-- Instant prompt: Oxide-style bind / unbind on PromptButtonHoldBegan
local instantPickupConns = {}
local function SetupInstantPickup(enabled)
    instantPickupEnabled = enabled
    local pps = game:GetService("ProximityPromptService")
    if not enabled then
        for conn in pairs(instantPickupConns) do
            pcall(function() conn:Disconnect() end)
            instantPickupConns[conn] = nil
        end
        if instantPickupConn then
            pcall(function() instantPickupConn:Disconnect() end)
            instantPickupConn = nil
        end
        return
    end
    if instantPickupConn or next(instantPickupConns) then
        return -- already bound
    end
    local ok, conn = pcall(function()
        return pps.PromptButtonHoldBegan:Connect(function(ProximityPrompt, Player)
            if Player == LP and tostring(ProximityPrompt) == "CarryAreaEgg" then
                ProximityPrompt.HoldDuration = 0
            end
        end)
    end)
    if ok and conn then
        instantPickupConn = track(conn)
        instantPickupConns[conn] = conn
    end
end

