HUB.SendDiscordWebhook = function(payload)
	local url = tostring(HUB.webhookUrl or "")
	if url == "" then return false, "no url" end
	if not url:find("discord", 1, true) then return false, "invalid url" end
	local HttpService = game:GetService("HttpService")
	local body
	local okJ, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
	if not okJ then return false, "json" end
	body = encoded
	local req = (syn and syn.request)
		or (http and http.request)
		or http_request
		or request
		or (fluxus and fluxus.request)
	if type(req) ~= "function" then return false, "no request" end
	local ok, res = pcall(function()
		return req({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})
	end)
	if not ok then return false, tostring(res) end
	return true
end
