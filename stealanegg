-- Disable 3D rendering (state on HUB — no new main-chunk locals)
HUB._d3d = HUB._d3d or { enabled = false, gui = nil, saved = nil }
HUB.SetDisable3D = function(v)
	local st = HUB._d3d
	st.enabled = v == true
	if st.enabled then
		if not st.saved then
			st.saved = {}
			pcall(function()
				local ug = UserSettings():GetService("UserGameSettings")
				st.saved.SavedQualityLevel = ug.SavedQualityLevel
				ug.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
			end)
			pcall(function()
				st.saved.Ambient = Lighting.Ambient
				st.saved.OutdoorAmbient = Lighting.OutdoorAmbient
				st.saved.Brightness = Lighting.Brightness
				st.saved.GlobalShadows = Lighting.GlobalShadows
				st.saved.FogEnd = Lighting.FogEnd
				st.saved.FogStart = Lighting.FogStart
				Lighting.Ambient = Color3.new(0, 0, 0)
				Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
				Lighting.Brightness = 0
				Lighting.GlobalShadows = false
				Lighting.FogEnd = 0
				Lighting.FogStart = 0
			end)
		end
		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		pcall(function()
			for _, fx in ipairs(Lighting:GetChildren()) do
				if fx:IsA("PostEffect") or fx:IsA("BloomEffect") or fx:IsA("BlurEffect")
					or fx:IsA("ColorCorrectionEffect") or fx:IsA("SunRaysEffect")
					or fx:IsA("DepthOfFieldEffect") then
					fx.Enabled = false
				end
			end
		end)
		if st.gui and st.gui.Parent then
			st.gui.Enabled = true
			return
		end
		local parent = nil
		pcall(function()
			if gethui then parent = gethui() end
		end)
		if not parent then
			pcall(function() parent = game:GetService("CoreGui") end)
		end
		if not parent then
			parent = LP:FindFirstChildOfClass("PlayerGui")
		end
		if not parent then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "VantaDisable3D"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = -100
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		pcall(function()
			if syn and syn.protect_gui then syn.protect_gui(gui) end
		end)
		pcall(function() gui.Parent = parent end)
		if not gui.Parent then return end
		local bg = Instance.new("Frame")
		bg.Name = "Blackout"
		bg.BackgroundColor3 = Color3.new(0, 0, 0)
		bg.BorderSizePixel = 0
		bg.Size = UDim2.fromScale(1, 1)
		bg.Position = UDim2.fromScale(0, 0)
		bg.ZIndex = 1
		bg.Active = false
		bg.Parent = gui
		local label = Instance.new("TextLabel")
		label.Name = "Status"
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -40, 0, 80)
		label.Position = UDim2.new(0, 20, 0.5, -40)
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 22
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = "Auto farming in place -- getvanta.fun"
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextYAlignment = Enum.TextYAlignment.Center
		label.ZIndex = 2
		label.Active = false
		label.Parent = bg
		pcall(function()
			local roots = {}
			if gethui then
				for _, g in ipairs(gethui():GetChildren()) do table.insert(roots, g) end
			end
			pcall(function()
				for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do table.insert(roots, g) end
			end)
			for _, g in ipairs(roots) do
				if g:IsA("ScreenGui") and g.Name ~= "VantaDisable3D" then
					local n = string.lower(g.Name)
					if n:find("vind", 1, true) or n:find("vanta", 1, true) or n:find("nullui", 1, true) or n:find("wind", 1, true) then
						if g.DisplayOrder < 50 then g.DisplayOrder = 100 end
					end
				end
			end
			if VindUI and VindUI._Root and VindUI._Root:IsA("ScreenGui") then
				if VindUI._Root.DisplayOrder < 50 then VindUI._Root.DisplayOrder = 100 end
			end
		end)
		st.gui = gui
		table.insert(HUB.drawings, gui)
	else
		if st.gui then
			pcall(function() st.gui:Destroy() end)
			st.gui = nil
		end
		if st.saved then
			pcall(function()
				local ug = UserSettings():GetService("UserGameSettings")
				if st.saved.SavedQualityLevel ~= nil then
					ug.SavedQualityLevel = st.saved.SavedQualityLevel
				end
			end)
			pcall(function()
				if st.saved.Ambient then Lighting.Ambient = st.saved.Ambient end
				if st.saved.OutdoorAmbient then Lighting.OutdoorAmbient = st.saved.OutdoorAmbient end
				if st.saved.Brightness then Lighting.Brightness = st.saved.Brightness end
				if st.saved.GlobalShadows ~= nil then Lighting.GlobalShadows = st.saved.GlobalShadows end
				if st.saved.FogEnd then Lighting.FogEnd = st.saved.FogEnd end
				if st.saved.FogStart then Lighting.FogStart = st.saved.FogStart end
			end)
			st.saved = nil
		end
	end
end

local function SetFullbright(v)
    fullbrightEnabled = v
    if v then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
