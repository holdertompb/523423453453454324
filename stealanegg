HUB.LogStealWebhook = function(record, targetItem)
	if HUB.webhookEnabled == false then return end
	local url = tostring(HUB.webhookUrl or "")
	if url == "" then return end
	record = record or {}
	if targetItem and type(targetItem) == "table" and type(targetItem.record) == "table" then
		record = targetItem.record
	end

	local eggName = nil
	pcall(function()
		local cat = record.AssetCategory or record.Category or record.AssetId or record.Name
		if cat and AssetsData then
			local dir = AssetsData.Directory or AssetsData
			local info = dir and dir[cat]
			if type(info) == "table" then
				eggName = info.DisplayName or info.Name or info._id
			end
			if (not eggName or eggName == "") and type(cat) == "string" and not cat:match("^[%x%-]+$") and #cat < 64 then
				eggName = cat
			end
		end
	end)
	if not eggName or eggName == "" then
		eggName = record.DisplayName or record.EggName or record.PetName or record.AssetCategory or record.Category
	end
	if not eggName or eggName == "" or tostring(eggName) == tostring(record.Uid) then
		eggName = "Unknown Egg"
	end
	eggName = tostring(eggName)

	local rarity = nil
	if targetItem and targetItem.rarity then
		rarity = tostring(targetItem.rarity)
	end
	if not rarity or rarity == "" or rarity == "Unknown" then
		local r = record.Rarity
		if type(r) == "table" then
			rarity = tostring(r.DisplayName or r._id or r.Name or "")
		elseif type(r) == "string" then
			rarity = r
		end
	end
	if not rarity or rarity == "" or rarity == "Unknown" then
		pcall(function()
			local cat = record.AssetCategory or record.Category or record.Name
			if cat and AssetsData then
				local dir = AssetsData.Directory or AssetsData
				local aInfo = dir and dir[cat]
				if aInfo and aInfo.Rarity then
					local r = aInfo.Rarity
					rarity = type(r) == "table" and tostring(r.DisplayName or r._id or r.Name) or tostring(r)
				end
			end
		end)
	end
	if not rarity or rarity == "" or rarity == "Unknown" then
		pcall(function()
			local dir = AreasData and (AreasData.Directory or AreasData)
			local areaData = dir and dir[record.AreaId]
			local rarityObj = areaData and areaData.Rarity
			if type(rarityObj) == "table" then
				rarity = tostring(rarityObj.DisplayName or rarityObj._id or rarityObj.Name or "Unknown")
			elseif type(rarityObj) == "string" then
				rarity = rarityObj
			end
			if RarityData and rarity then
				local raritiesTable = RarityData.Rarities or RarityData
				local rInfo = raritiesTable[rarity]
				if type(rInfo) == "table" then
					rarity = tostring(rInfo.DisplayName or rInfo._id or rarity)
				end
			end
		end)
	end
	if not rarity or rarity == "" then rarity = "Unknown" end

	local area = tostring(record.AreaId or record.Area or "Unknown")
	pcall(function()
		local dir = AreasData and (AreasData.Directory or AreasData)
		local id = record.AreaId or record.Area
		if dir and id and dir[id] then
			local a = dir[id]
			area = tostring(a.DisplayName or a.Name or a._id or id)
		elseif type(AREA_NAMES) == "table" then
			local raw = tostring(id or "")
			for _, n in ipairs(AREA_NAMES) do
				local nl = string.lower(tostring(n)):gsub("[%s_%-]+", "")
				local rl = string.lower(raw):gsub("[%s_%-]+", "")
				if nl == rl or (rl ~= "" and nl:find(rl, 1, true)) or (nl ~= "" and rl:find(nl, 1, true)) then
					area = tostring(n)
					break
				end
			end
		end
	end)

	local muts = {}
	local msrc = record.Mutations or record.Mutation or record.Traits
	if type(msrc) == "string" and msrc ~= "" then
		table.insert(muts, msrc)
	elseif type(msrc) == "table" then
		for k, v in pairs(msrc) do
			if type(v) == "string" and v ~= "" then
				table.insert(muts, v)
			elseif v == true and type(k) == "string" then
				table.insert(muts, k)
			elseif type(v) == "table" then
				local n = v.Name or v.DisplayName or v._id
				if n then table.insert(muts, tostring(n)) end
			end
		end
	end
	if record.HasParasite == true then table.insert(muts, "Parasite") end
	if record.MutationName and tostring(record.MutationName) ~= "" then
		table.insert(muts, tostring(record.MutationName))
	end
	local seen, uniq = {}, {}
	for _, m in ipairs(muts) do
		local k = string.lower(tostring(m))
		if not seen[k] then seen[k] = true; table.insert(uniq, tostring(m)) end
	end
	local mutText = (#uniq > 0) and table.concat(uniq, ", ") or "None"

	local playerName = "Unknown"
	pcall(function() playerName = LP.DisplayName or LP.Name end)

	HUB.SendDiscordWebhook({
		embeds = {{
			title = "Egg Stolen! · " .. eggName,
			color = 5763719,
			fields = {
				{ name = "Rarity", value = rarity, inline = true },
				{ name = "Area", value = area, inline = true },
				{ name = "Mutations", value = mutText, inline = true },
				{ name = "Player", value = playerName, inline = true },
			},
			footer = { text = "getvanta.fun" },
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
